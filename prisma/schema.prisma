generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  playlists         Playlist[]
  favorites         Favorite[]
  listeningHistory  ListeningHistory[]
  downloads         Download[]
  plays             Play[]
  creatorProfiles   Artist[]

  @@map("users")
}

// Standard Auth.js adapter tables. Not used by the credentials-only flow today,
// but kept in place so an OAuth provider can be added later with no migration.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Artist {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  bio        String?  @db.Text
  avatarUrl String?
  avatarImagePublicId String?
  coverUrl  String?
  coverImagePublicId  String?
  isFeatured Boolean @default(false)
  /// Shown on the creator profile only if the creator chooses to disclose it.
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The account that runs this creator profile. Null for profiles an admin
  /// created on the platform's behalf. Being a creator isn't a role: any
  /// account that owns a profile can publish through it, so one person can
  /// listen, create, and run more than one project name.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  albums Album[]
  tracks Track[]

  @@index([isFeatured])
  @@index([ownerId])
  @@map("artists")
}

model Album {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  artistId    String
  coverUrl    String?
  coverImagePublicId String?
  description String?   @db.Text
  releaseDate DateTime?
  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  artist Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks Track[]

  @@index([artistId])
  @@index([isPublished, isFeatured])
  @@map("albums")
}

// ---------------------------------------------------------------------------
// Discovery taxonomy
//
// Genres, moods, activities, occasions, instruments, languages, vocal
// characteristics and tags are all the same shape: a controlled, admin-curated
// term with a name, slug, description, artwork and ordering. They live in one
// table keyed by `kind` rather than eight near-identical tables, which buys:
//
//   - one admin CRUD surface instead of eight
//   - one reusable filter component across every discovery page
//   - cross-kind queries (a track's full classification) in a single join
//   - new dimensions (era, region) without a migration
//
// This is still fully normalised — terms are rows with foreign keys, not a
// denormalised string column. Hierarchy (subgenres) uses `parentId`.
// ---------------------------------------------------------------------------

enum TaxonomyKind {
  GENRE
  MOOD
  ACTIVITY
  OCCASION
  INSTRUMENT
  LANGUAGE
  VOCAL
  TAG
}

model TaxonomyTerm {
  id          String       @id @default(cuid())
  kind        TaxonomyKind
  name        String
  slug        String
  description String?      @db.Text

  imageUrl      String?
  imagePublicId String?

  /// Subgenres, and sub-terms generally (e.g. Activity "Study" → "Exam Prep").
  parentId String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   TaxonomyTerm?  @relation("TermHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children TaxonomyTerm[] @relation("TermHierarchy")
  tracks   TrackTerm[]

  /// Canonical per kind — prevents "sleep" / "Sleep" / "sleep-music" drifting
  /// into separate categories.
  @@unique([kind, slug])
  @@index([kind, isActive, displayOrder])
  @@index([kind, isFeatured])
  @@index([parentId])
  @@map("taxonomy_terms")
}

model TrackTerm {
  trackId String
  termId  String

  /// Primary genre vs. secondary genres. Meaningless for other kinds.
  isPrimary Boolean @default(false)

  track Track        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  term  TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([trackId, termId])
  /// Drives every discovery page: "published tracks carrying this term".
  @@index([termId])
  @@index([trackId])
  @@map("track_terms")
}

enum ProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

/// Moderation is deliberately separate from `isPublished`/`processingStatus`
/// rather than collapsed into one status column: every existing query filters
/// `isPublished`, and rewriting those was a needless risk. NONE means the
/// platform is publishing automatically, which is the current policy.
enum ModerationStatus {
  NONE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum EnergyLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

/// The creator asserts this; the platform does not infer or verify it.
enum AiDisclosure {
  AI_GENERATED
  AI_ASSISTED
  HUMAN_CREATED
}

model Track {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  artistId          String
  albumId           String?
  trackNumber       Int?
  description       String?   @db.Text
  duration          Int       @default(0) // seconds

  /// Legacy/local-driver URL fields. Populated directly when STORAGE_DRIVER=local
  /// (or for tracks uploaded before the R2 migration). MediaService prefers the
  /// *StorageKey fields below and falls back to these when a key is absent, so
  /// old rows keep working without a forced backfill.
  audioUrl          String?
  originalAudioUrl  String?
  downloadAudioUrl  String?
  fileSize          Int?
  mimeType          String?

  /// R2 object keys — the source of truth once set. Never store presigned
  /// URLs here; MediaService derives an access URL from the key on demand.
  originalStorageKey  String?
  streamingStorageKey String?
  downloadStorageKey  String?
  originalFormat      String?
  streamingFormat     String?
  downloadFormat      String?
  originalSize        Int?
  streamingSize       Int?
  downloadSize        Int?

  processingStatus ProcessingStatus @default(READY)
  processingError  String?          @db.Text

  /// Cover falls back to the album's cover when null (see toPlayerTrack).
  coverUrl           String?
  coverImagePublicId String?
  coverImageUrl      String?
  coverImageWidth    Int?
  coverImageHeight   Int?

  releaseDate        DateTime?
  lyrics            String?   @db.Text
  credits           String?   @db.Text
  composer          String?
  producer          String?
  /// Retained so existing queries and the public "AI Composed" badge keep
  /// working; `aiDisclosure` is the richer replacement and the two are kept
  /// consistent on write.
  isAiGenerated     Boolean   @default(true)
  aiDisclosure      AiDisclosure @default(AI_GENERATED)
  /// Free text, creator-supplied: generation tool, human editing, vocals.
  aiTool            String?
  aiDetails         String?   @db.Text

  /// Set when the creator accepts the rights confirmation at publish time.
  /// Null means it has never been accepted for this track.
  rightsConfirmedAt DateTime?
  rightsConfirmedBy String?

  /// Creator uploads can only become public through admin approval, which is
  /// what sets `isPublished`. Public queries keep filtering on `isPublished`
  /// alone, so nothing pending or rejected can surface on any page — without
  /// every query needing to remember a second condition.
  moderationStatus  ModerationStatus @default(NONE)
  /// Why a track was rejected, shown to its creator so they can fix it.
  moderationNote    String?   @db.Text
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?

  energy            EnergyLevel?
  tempoBpm          Int?

  isExplicit        Boolean   @default(false)
  isPublished       Boolean   @default(false)
  isFeatured        Boolean   @default(false)
  downloadEnabled   Boolean   @default(true)
  playCount         Int       @default(0)
  downloadCount     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  artist  Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album   Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  terms   TrackTerm[]
  playlistTracks    PlaylistTrack[]
  favorites         Favorite[]
  listeningHistory  ListeningHistory[]
  downloads         Download[]
  plays             Play[]

  @@index([artistId])
  @@index([albumId])
  @@index([isPublished, isFeatured])
  @@index([isPublished, createdAt])
  @@index([processingStatus])
  /// The admin review queue: pending submissions, oldest first.
  @@index([moderationStatus, submittedAt])
  @@map("tracks")
}


// ---------------------------------------------------------------------------
// Playlists & library
// ---------------------------------------------------------------------------

enum PlaylistKind {
  /// Built by a listener.
  USER
  /// Curated by the platform — hand-picked track list.
  EDITORIAL
  /// Defined by taxonomy rules, not a stored track list. Membership is
  /// resolved at query time so a track is never duplicated into a collection
  /// (see `rules`).
  ALGORITHMIC
}

model Playlist {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  coverUrl    String?
  coverImagePublicId String?
  isPublic    Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kind       PlaylistKind @default(USER)
  isFeatured Boolean      @default(false)

  /// ALGORITHMIC only. Shape: { "all": [termId, ...], "any": [termId, ...],
  /// "energy": "LOW", "limit": 50 } — resolved by CollectionService rather
  /// than copying track rows.
  rules Json?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([userId])
  @@index([kind, isPublic])
  @@index([kind, isFeatured])
  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
  @@map("playlist_tracks")
  @@index([addedAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@map("favorites")
  @@index([createdAt])
}

model ListeningHistory {
  id              String   @id @default(cuid())
  userId          String
  trackId         String
  playedAt        DateTime @default(now())
  progressSeconds Int      @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@map("listening_history")
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@map("downloads")
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model Play {
  id              String   @id @default(cuid())
  trackId         String
  userId          String?
  sessionId       String?
  progressSeconds Int      @default(0)
  completed       Boolean  @default(false)
  countedAsPlay   Boolean  @default(false)
  createdAt       DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([trackId, createdAt])
  @@map("plays")
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Site configuration
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
