generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  playlists         Playlist[]
  favorites         Favorite[]
  listeningHistory  ListeningHistory[]
  downloads         Download[]
  plays             Play[]

  @@map("users")
}

// Standard Auth.js adapter tables. Not used by the credentials-only flow today,
// but kept in place so an OAuth provider can be added later with no migration.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Artist {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  bio        String?  @db.Text
  avatarUrl String?
  avatarImagePublicId String?
  coverUrl  String?
  coverImagePublicId  String?
  isFeatured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  albums Album[]
  tracks Track[]

  @@index([isFeatured])
  @@map("artists")
}

model Album {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  artistId    String
  coverUrl    String?
  coverImagePublicId String?
  description String?   @db.Text
  releaseDate DateTime?
  isPublished Boolean   @default(false)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  artist Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks Track[]

  @@index([artistId])
  @@index([isPublished, isFeatured])
  @@map("albums")
}

model Genre {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  coverUrl String?

  tracks TrackGenre[]

  @@map("genres")
}

enum ProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Track {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  artistId          String
  albumId           String?
  trackNumber       Int?
  description       String?   @db.Text
  duration          Int       @default(0) // seconds

  /// Legacy/local-driver URL fields. Populated directly when STORAGE_DRIVER=local
  /// (or for tracks uploaded before the R2 migration). MediaService prefers the
  /// *StorageKey fields below and falls back to these when a key is absent, so
  /// old rows keep working without a forced backfill.
  audioUrl          String?
  originalAudioUrl  String?
  downloadAudioUrl  String?
  fileSize          Int?
  mimeType          String?

  /// R2 object keys — the source of truth once set. Never store presigned
  /// URLs here; MediaService derives an access URL from the key on demand.
  originalStorageKey  String?
  streamingStorageKey String?
  downloadStorageKey  String?
  originalFormat      String?
  streamingFormat     String?
  downloadFormat      String?
  originalSize        Int?
  streamingSize       Int?
  downloadSize        Int?

  processingStatus ProcessingStatus @default(READY)
  processingError  String?          @db.Text

  /// Cover falls back to the album's cover when null (see toPlayerTrack).
  coverUrl           String?
  coverImagePublicId String?
  coverImageUrl      String?
  coverImageWidth    Int?
  coverImageHeight   Int?

  releaseDate        DateTime?
  lyrics            String?   @db.Text
  credits           String?   @db.Text
  composer          String?
  producer          String?
  isAiGenerated     Boolean   @default(true)
  isExplicit        Boolean   @default(false)
  isPublished       Boolean   @default(false)
  isFeatured        Boolean   @default(false)
  downloadEnabled   Boolean   @default(true)
  playCount         Int       @default(0)
  downloadCount     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  artist  Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album   Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  genres  TrackGenre[]
  playlistTracks    PlaylistTrack[]
  favorites         Favorite[]
  listeningHistory  ListeningHistory[]
  downloads         Download[]
  plays             Play[]

  @@index([artistId])
  @@index([albumId])
  @@index([isPublished, isFeatured])
  @@index([isPublished, createdAt])
  @@index([processingStatus])
  @@map("tracks")
}

model TrackGenre {
  trackId String
  genreId String

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@map("track_genres")
}

// ---------------------------------------------------------------------------
// Playlists & library
// ---------------------------------------------------------------------------

model Playlist {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
  @@map("playlist_tracks")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@map("favorites")
}

model ListeningHistory {
  id              String   @id @default(cuid())
  userId          String
  trackId         String
  playedAt        DateTime @default(now())
  progressSeconds Int      @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@map("listening_history")
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@map("downloads")
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model Play {
  id              String   @id @default(cuid())
  trackId         String
  userId          String?
  sessionId       String?
  progressSeconds Int      @default(0)
  completed       Boolean  @default(false)
  countedAsPlay   Boolean  @default(false)
  createdAt       DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([trackId, createdAt])
  @@map("plays")
}

// ---------------------------------------------------------------------------
// Site configuration
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
