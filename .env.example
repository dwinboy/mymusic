# =============================================================================
# Database (PostgreSQL) — metadata only. Audio and artwork binaries never
# touch this database; see R2 / Cloudinary below.
# =============================================================================
DATABASE_URL="postgresql://vibebanger_app:vibebanger_dev_password@localhost:5432/vibebanger_dev"

# =============================================================================
# NextAuth
# =============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-base64-secret" # openssl rand -base64 32
# Required for self-hosted production (Docker, a plain Node server, etc.) —
# see auth.config.ts for why. Leave unset in this file; auth.config.ts sets
# it to true unconditionally since NEXTAUTH_URL above already pins the origin.

# Public site URL, used for absolute URLs in metadata/sitemap/OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =============================================================================
# AUDIO — Cloudflare R2 (S3-compatible object storage)
# =============================================================================
# AUDIO_STORAGE_DRIVER: "local" (default) writes to /public/uploads/audio* —
# zero setup, fine for local dev. Set to "r2" to upload directly to R2
# instead: new tracks then upload straight from the browser to R2 via a
# presigned URL (the file never passes through the Next.js server), and
# playback/downloads are served from R2's CDN.
AUDIO_STORAGE_DRIVER="local"

# --- SERVER ONLY — never expose these to the browser ---
R2_ACCOUNT_ID=""              # Cloudflare dashboard → R2 → Overview
R2_ACCESS_KEY_ID=""           # R2 → Manage API Tokens → create a token
R2_SECRET_ACCESS_KEY=""       # (same token)
R2_BUCKET_NAME=""             # e.g. "vibebanger-media"
R2_ENDPOINT=""                # optional override; derived from R2_ACCOUNT_ID
                               # as https://<account_id>.r2.cloudflarestorage.com
                               # if left blank. Local dev against MinIO:
                               # http://localhost:9000

# Public read path for the bucket — a custom domain you've mapped to the
# bucket (R2 → bucket → Settings → Custom Domains) is strongly recommended
# for production; an r2.dev subdomain works for testing. Local dev against
# MinIO: http://localhost:9000/<bucket-name> (after `mc anonymous set
# download <alias>/<bucket-name>`).
R2_PUBLIC_BASE_URL=""

# =============================================================================
# IMAGES — Cloudinary (artwork: covers, artist photos, playlist art)
# =============================================================================
# IMAGE_PROVIDER: "local" (default) writes to /public/uploads/covers|avatars.
# Set to "cloudinary" to upload directly from the browser to Cloudinary
# (signed, never through our server) and serve responsive, transformed URLs.
IMAGE_PROVIDER="local"

# --- SERVER ONLY ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""      # never expose — used only to sign upload requests

# =============================================================================
# Legacy generic storage driver — used only as the local-dev fallback path
# above (STORAGE_DRIVER unset/"local" is what /public/uploads writes through
# for both audio and images today). You generally don't need to touch this;
# it predates the R2/Cloudinary split and is kept only so an existing local
# setup isn't disturbed. Prefer AUDIO_STORAGE_DRIVER / IMAGE_PROVIDER above
# for anything new.
# =============================================================================
STORAGE_DRIVER="local"
